{
  "name": "@workspace/split-deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "split-deploy": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "split-deploy": "tsx src/cli.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  }
}